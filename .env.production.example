PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
DJANGO_DEBUG=False
DJANGO_PRODUCTION=True
DJANGO_REQUIRE_EXTERNAL_SERVICES=True
DJANGO_SECRET_KEY=replace-with-a-strong-secret-key
DJANGO_ALLOWED_HOSTS=nakheel-najd.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://getsiaq.online,https://www.getsiaq.online,https://nakheel-najd.onrender.com
SITE_DOMAIN=getsiaq.online
WWW_SITE_DOMAIN=www.getsiaq.online
SITE_URL=https://getsiaq.online
DATABASE_URL=<render-postgresql-connection-url>
SQLITE_NAME=db.sqlite3
MEDIA_ROOT=media
# الصيغة الموصى بها في Render. لا تحفظ القيمة الحقيقية داخل المستودع.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
STATIC_ROOT=staticfiles_build
USE_CLOUDINARY_MEDIA=True
DJANGO_SERVE_MEDIA_FILES=False
WHITENOISE_MANIFEST_STRICT=False
WHITENOISE_MAX_AGE=86400
DATA_UPLOAD_MAX_MEMORY_SIZE=8388608
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_NUMBER_FILES=30
DJANGO_ENABLE_HTTPS_SECURITY=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
TOKENMIX_API_KEY=
TOKENMIX_BASE_URL=https://api.tokenmix.ai/v1
TOKENMIX_MODEL=gpt-4o-mini
AI_DAILY_SEO_ENABLED=False
# Run the heavy/destructive seed only deliberately (for a fresh/controlled environment).
DJANGO_BOOTSTRAP_ON_START=False

# Google Search Console (preferred over storing credentials in the database)
GOOGLE_SEARCH_CONSOLE_PROPERTY=https://getsiaq.online/
GOOGLE_SERVICE_ACCOUNT_JSON=
DJANGO_SUPERUSER_USERNAME=<admin-username>
DJANGO_SUPERUSER_PASSWORD=<one-time-secure-admin-password>
DJANGO_SUPERUSER_FORCE_PASSWORD_RESET=False
FRONTEND_URL=https://getsiaq.online
FRONTEND_API_SECRET=change-this-to-a-long-random-secret
CORS_ALLOWED_ORIGINS=https://getsiaq.online,https://www.getsiaq.online
API_PAGE_SIZE=12
API_SUBMISSION_RATE=10/hour
